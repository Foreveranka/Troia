# Optional addition to the backend environment. Never include this file in the extension.
BANK_TRANSFER_MODE=disabled
# Set mode=bridge ONLY after implementing/verifying the private protocol in docs/bank-transfer-integration.md.
BANK_TRANSFER_API_BASE_URL=https://provider-bridge.example/v1
BANK_TRANSFER_PROVIDER_ID=
BANK_TRANSFER_API_KEY=
# Required explicit negotiated costs and settlement terms when enabling. Not card/iyzico costs.
BANK_TRANSFER_FEE_BPS=
BANK_TRANSFER_FIXED_KURUS=
BANK_TRANSFER_VALOR_DAYS=
BANK_TRANSFER_MARGIN_BPS=

# Sandbox alternative: BANK_TRANSFER_MODE=tr-mock-anchor
# Prepare the separate TESTNET account with scripts/prepare-anchor-sandbox.mjs.
# Then load the generated .env.bank-sandbox AFTER .env.anchor (never copy into the extension).
# BANK_TRANSFER_ANCHOR_SECRET=  # server-only; separate from payout operator/admin
