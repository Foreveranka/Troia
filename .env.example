# Troia secrets — copy this file to .env (git-ignored) and fill real values.
# NEVER commit real secrets. The repo only ever contains these placeholders.
#
# Three separate Stellar keypairs (no collapse, even on testnet):
TROIA_ADMIN_SECRET=
TROIA_OPERATOR_SECRET=
TROIA_ISSUER_SECRET=
#
# iyzico (fiat leg) API credentials:
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
#
# Webhook HMAC verification secret (iyzico signs the callback with the account secretKey unless a distinct key is
# issued; blank -> IYZICO_SECRET_KEY is used):
WEBHOOK_SIGNING_SECRET=
#
# The PUBLIC url iyzico redirects the customer's browser to after payment — a tunnel on testnet pointing at the
# /return landing page (e.g. cloudflared: the https URL + /return). REQUIRED by `just serve`. Settlement is driven
# by the poll worker's server-side pull, not this URL. See docs/LIVE_SMOKE.md.
TROIA_CALLBACK_URL=
#
# Optional server tunables (sane defaults if blank): PORT=3000, HOST=0.0.0.0, POLL_INTERVAL_MS=5000 (>=1000),
# TROIA_DEPLOYMENT_PATH=deployment.testnet.json. Bad values fail the boot CLOSED (never a silent degrade).
# PORT=
# POLL_INTERVAL_MS=
#
# Where the append-only accounting journal and settlement-evidence logs are kept (default ./data, git-ignored).
# These are what survive a restart: the ledger's expected pool balance and the set of payouts we authorized.
# The directory is created 0700 and its files 0600 — they carry signed envelopes and merchant destinations.
# TROIA_DATA_DIR=data
#
# How often the solvency tripwire weighs the on-chain pool balance against the ledger's expectation. Must exceed
# SETTLEMENT_TICK_MS: a payout lands on chain before the settlement worker books it, and reading inside that
# window would report bookkeeping in flight as drift. Default 30000.
# RECON_INTERVAL_MS=30000
