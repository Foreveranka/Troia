[Unit]
Description=Troia Stellar testnet settlement and IBAN sandbox
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=troia
Group=troia
WorkingDirectory=/opt/troia/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3108
Environment=TROIA_DATA_DIR=/var/lib/troia/state
Environment=TROIA_DEPLOYMENT_PATH=/opt/troia/current/deployment.testnet.json
Environment=TROIA_FUNDING_MODE=manual
EnvironmentFile=/etc/troia/backend.env
ExecStart=/opt/troia/current/ops/start-backend.sh
Restart=always
RestartSec=10
TimeoutStopSec=40
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/troia
UMask=0077
MemoryMax=384M
CPUQuota=50%
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
